{
  "name": "git-relay",
  "version": "0.1.1",
  "description": "GitRelay: Git worktree change awareness for Codex",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "git",
    "worktree",
    "coding-agent"
  ],
  "files": [
    "dist",
    "src/adapters/codex/*.json",
    "skills",
    "docs/*.md",
    "!docs/optimization-rounds.md",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    ".codex-plugin",
    "assets"
  ],
  "bin": {
    "git-relay": "./dist/cli/main.js",
    "worktree-relay": "./dist/cli/main.js",
    "worktree-sync": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run format:check && npm run typecheck && npm run check:release && npm test && npm pack --dry-run",
    "build": "node scripts/build.mjs",
    "build:codex-plugin": "npm run build && node scripts/build-codex-plugin.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/core/*.test.ts tests/adapters/*.test.ts tests/cli/*.test.*"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/core/consumer.js": "./dist/core/consumer.js",
    "./dist/core/mailbox.js": "./dist/core/mailbox.js",
    "./dist/core/sessions.js": "./dist/core/sessions.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shenyankm/GitRelay.git"
  }
}
